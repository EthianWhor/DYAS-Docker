# Variante SOLO para la pregunta de discusión del Paso 4: copia el código ANTES de instalar
# las dependencias. Cualquier cambio en app.py invalida la capa de "pip install".
# Construir con: docker build --progress=plain -f Dockerfile.orden-invertido -t friendlyhello:orden-invertido .
FROM python:3.14-slim

WORKDIR /app

COPY . .
RUN pip install --no-cache-dir -r requirements.txt

RUN useradd --system --no-create-home app
USER app

ENV NAME=World
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --start-interval=2s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)"

CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "2", "app:app"]
